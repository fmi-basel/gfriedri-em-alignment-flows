profiles {
    standard {
        conda.enabled = true
        conda.useMamba = true
        conda.cacheDir = "$baseDir/../infrastructure/envs/"

        process {
            executor = 'local'
            maxForks = 1

            withLabel: 'cpu_short' {
                conda = "$baseDir/../infrastructure/env-yamls/environment.yaml"
                cpus = 2
            }

            withLabel: 'cpu' {
                conda = "$baseDir/../infrastructure/env-yamls/environment.yaml"
                cpus = 2
            }
        }
    }


    slurm {
        conda.enabled = true
        conda.useMamba = true
        conda.cacheDir = "$baseDir/../infrastructure/envs/"


        executor {
            name = 'slurm'
            submitRateLimit = '2 sec'
            queueSize = 10
            queue = 'main'
        }

        process {

            withLabel: 'cpu_small' {
                conda = "$baseDir/../infrastructure/env-yamls/environment.yaml"
                cpus = 2
                memory = '4 GB'
                clusterOptions = '--time=02:00:00 --constraint "infiniband"'
            }
            withLabel: 'cpu' {
                conda = "$baseDir/../infrastructure/env-yamls/environment.yaml"
                cpus = 2
                memory = '6 GB'
                clusterOptions = '--time=02:00:00 --constraint "infiniband"'
            }
        }
    }
}
